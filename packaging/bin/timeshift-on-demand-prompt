#!/bin/bash
#
# timeshift-on-demand-prompt — zenity confirm + live-monitor backup runner.
#
# Invoked by the login autostart entry
# (packaging/timeshift-on-demand-autostart.desktop) and by the
# resume-from-suspend hook
# (packaging/systemd-sleep/timeshift-on-demand-resume-hook), always as
# the logged-in user — never as root itself. The one privileged step,
# the actual backup, goes through `pkexec` below, same as the GUI's own
# Backup tab. Entirely independent of whether the Companion GTK app
# (timeshift-on-demand) is open or not — this script never touches it,
# so there's no single-instance/GApplication concern to worry about here.
#
# The autostart entry passes --login and the resume hook passes --resume,
# so each can be turned off separately in the Settings tab. With neither
# flag it always prompts.
#
# Ports the "live monitor window" behavior of the author's earlier
# standalone timeshift-ondemand-backup.sh script, with two portability
# fixes: `sudo` -> `pkexec` against Companion's own
# bundled helper, and the hardcoded drive UUID replaced by the backup
# device Timeshift itself is configured with (/etc/timeshift/timeshift.json).
#
# No time-window restriction (the old script's 16:00-17:30
# scheduled-backup-slot block) — on-demand runs are always allowed.
# Shares its log file with the GUI's own BackupRunner
# (src/backup_runner.py) so both paths' history lands in one place.

LOGFILE="${XDG_DATA_HOME:-$HOME/.local/share}/timeshift-on-demand/backup.log"
GUI_MONITOR="/usr/lib/timeshift-on-demand/timeshift-on-demand-gui-monitor"
BACKUP_HELPER="/usr/lib/timeshift-on-demand/timeshift-on-demand-backup-helper"
LAST_RUN_PY="/usr/share/timeshift-on-demand/last_run.py"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/timeshift-on-demand/config.json"
TIMESHIFT_CONFIG="/etc/timeshift/timeshift.json"

mkdir -p "$(dirname "$LOGFILE")"

# Keep the log from growing forever (each run appends thousands of
# progress fragments): past 10 MiB, keep the last 5 MiB. Same limits as
# src/backup_runner.py.
if [[ -f "$LOGFILE" && $(stat -c %s "$LOGFILE") -gt 10485760 ]]; then
    tail -c 5242880 "$LOGFILE" > "$LOGFILE.tmp" && mv "$LOGFILE.tmp" "$LOGFILE"
fi

log() {
    local level=$1; shift
    echo "$(date): [$level] $*" >> "$LOGFILE"
}
log_info() { log "INFO" "$@"; }
log_error() { log "ERROR" "$@"; }

# Tell the Dashboard how this run ended (src/last_run.py). Best effort: a
# failure to record must never change the backup's outcome.
record_last_run() {
    python3 "$LAST_RUN_PY" record --source prompt --outcome "$1" ${2:+--reason="$2"} >/dev/null 2>&1 || true
}

log_info "Prompt script started"

# Before the drive wait below, so a prompt that's off does nothing else.
# Only an explicit JSON false turns one off, same as src/config.py: a
# missing or broken config leaves the prompt on.
case "${1:-}" in
    --login) PROMPT_KEY=prompt_on_login ;;
    --resume) PROMPT_KEY=prompt_on_resume ;;
    *) PROMPT_KEY="" ;;
esac
if [[ -n "$PROMPT_KEY" ]]; then
    PROMPT_ENABLED=$(python3 -c "
import json, sys
try:
    with open(sys.argv[1], encoding='utf-8') as f:
        print('off' if json.load(f).get(sys.argv[2]) is False else 'on')
except Exception:
    print('on')
" "$CONFIG_FILE" "$PROMPT_KEY" 2>/dev/null)
    if [[ "$PROMPT_ENABLED" == "off" ]]; then
        log_info "$PROMPT_KEY is off in the Settings tab — exiting, nothing done."
        exit 0
    fi
fi

# The drive to wait for is whichever backup device Timeshift itself is
# configured with (world-readable), since that's where the backup goes.
# Same reading rules as status.get_timeshift_backup_device_uuid().
DRIVE_UUID=$(python3 -c "
import json, sys
try:
    with open(sys.argv[1], encoding='utf-8') as f:
        uuid = json.load(f).get('backup_device_uuid')
    print(uuid if isinstance(uuid, str) else '')
except Exception:
    print('')
" "$TIMESHIFT_CONFIG" 2>/dev/null)

if [[ -z "$DRIVE_UUID" ]]; then
    log_error "Timeshift has no backup device configured yet (open Timeshift and finish its setup) — exiting, nothing done."
    exit 0
fi

# Wait for the drive to be mounted (max 36 attempts, 5 seconds apart =
# 180s). Bumped up from the original 30s budget after real resume
# evidence: this class of USB enclosure can take over two minutes to
# finish ext4 journal recovery after an unclean suspend-unmount before
# it's actually mountable (observed up to 129s on 2026-08-31).
BACKUP_MOUNT_POINT=""
for i in {1..36}; do
    # Timeshift mounts the drive again at /run/timeshift/<pid>/backup
    # during a run; ignore that one and take the first real mount.
    BACKUP_MOUNT_POINT=$(findmnt -nr -S UUID="$DRIVE_UUID" -o TARGET | grep -v '^/run/timeshift/' | head -n 1)
    if [[ -n "$BACKUP_MOUNT_POINT" ]]; then
        log_info "Backup drive mounted at $BACKUP_MOUNT_POINT."
        break
    else
        log_info "Waiting for drive to mount (attempt $i)..."
        sleep 5
    fi
done

if [[ -z "$BACKUP_MOUNT_POINT" ]]; then
    log_error "Backup drive not mounted after wait, exiting (treated as non-fatal)."
    exit 0
fi

log_info "Showing confirmation dialog to user."
zenity --question --title="Timeshift On Demand" \
    --text="Do you want to start the on-demand Timeshift backup now?" --width=300
response=$?

if [[ $response -ne 0 ]]; then
    log_info "User cancelled the backup."
    exit 0
fi

log_info "User confirmed backup, starting."

# In $XDG_RUNTIME_DIR (0700, this user's only) rather than /tmp, where
# another local user could create the file at the predicted name first
# and feed the monitor window a fake result.
DONEFLAG=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/timeshift-on-demand-status.XXXXXX")
rm -f "$DONEFLAG"   # mktemp -u shouldn't create it, but be sure
MONITOR_LAUNCHED=false

# A single-purpose GTK window, not a spawned terminal — no
# gnome-terminal/xterm dependency at all (see timeshift-on-demand-gui-monitor's
# own header for why this replaced the old terminal-based monitor).
python3 "$GUI_MONITOR" "$LOGFILE" "$DONEFLAG" &
MONITOR_LAUNCHED=true

log_info "Running backup helper via pkexec..."
# Where this run's output starts, so the failure reason below comes from
# this run and not an earlier one in the same log.
RUN_START=$(stat -c %s "$LOGFILE" 2>/dev/null || echo 0)
ionice -c2 -n7 nice -n10 pkexec "$BACKUP_HELPER" >> "$LOGFILE" 2>&1
ts_status=$?

# Signal the monitor window (if running) that the backup has finished;
# if no monitor was launched, there's nothing to signal — clean up
# instead of leaving an orphaned sentinel file in /tmp.
if $MONITOR_LAUNCHED; then
    echo "STATUS=$ts_status" > "$DONEFLAG"
else
    rm -f "$DONEFLAG"
fi

if [[ $ts_status -eq 0 ]]; then
    record_last_run success
    log_info "Backup completed successfully."
    notify-send -i drive-harddisk "Timeshift On Demand" \
        "On-demand backup completed successfully." 2>/dev/null
elif [[ $ts_status -eq 126 ]]; then
    # Not recorded: the helper never ran, so an earlier failure stays on the Dashboard.
    log_error "Authentication dialog was dismissed — backup not run."
    notify-send -u critical -i dialog-error "Timeshift On Demand" \
        "Backup cancelled — authentication was dismissed." 2>/dev/null
elif [[ $ts_status -eq 127 ]]; then
    record_last_run failed "Authentication failed or was denied (pkexec exit 127) — check that the package's polkit policy is installed correctly."
    log_error "Authentication failed or was denied (pkexec exit 127)."
    notify-send -u critical -i dialog-error "Timeshift On Demand" \
        "Backup not authorized — check the polkit policy is installed correctly." 2>/dev/null
else
    # The helper ends a failure with "BACKUP-FAILED: <reason>" (progress
    # fragments can share its line, hence -a and the unanchored match).
    reason=$(tail -c +"$((RUN_START + 1))" "$LOGFILE" 2>/dev/null \
        | grep -ao 'BACKUP-FAILED: .*' | tail -n 1 | sed 's/^BACKUP-FAILED: //')
    record_last_run failed "${reason:-Timeshift failed (exit code $ts_status). See the log for details.}"
    if [[ -n "$reason" ]]; then
        log_error "Backup failed (exit code $ts_status): $reason"
        notify-send -u critical -i dialog-error "Timeshift On Demand — Backup FAILED" \
            "$reason Log: $LOGFILE" 2>/dev/null
    else
        log_error "Backup finished with exit code $ts_status."
        notify-send -u critical -i dialog-error "Timeshift On Demand — Backup FAILED" \
            "Exit code $ts_status — check $LOGFILE" 2>/dev/null
    fi
fi

log_info "Prompt script finished"
