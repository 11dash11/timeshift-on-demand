#!/usr/bin/env python3
"""
timeshift-on-demand-gui-monitor — live GTK progress window for
timeshift-on-demand-prompt.

Replaces the old gnome-terminal/xterm + timeshift-on-demand-monitor
(bash) combination — a single-purpose GTK window instead of a spawned
terminal running a script. This is a genuine simplification, not just a
cosmetic swap: it removes the terminal-emulator-detection dependency
entirely (gnome-terminal/xterm are no longer needed by this package at
all) and the double indirection of terminal-spawns-shell-runs-script.

Usage: timeshift-on-demand-gui-monitor <logfile> <doneflag> [close_delay_seconds]

Same argument shape as the bash monitor it replaces, so
timeshift-on-demand-prompt only needed to change what it launches, not
how it's invoked. Streams only new log lines from this point onward
(seeks to end of file first, same as the old `tail -f -n 0`), polls for
the doneflag, then shows a pass/fail summary — auto-closing after
close_delay seconds on success, staying open until manually closed on
failure. Not meant to be run standalone in production, but can be for
testing:

  LOG=/tmp/test.log; FLAG=/tmp/test.flag
  : > "$LOG"; rm -f "$FLAG"
  timeshift-on-demand-gui-monitor "$LOG" "$FLAG" 8 &
  sleep 1; echo "hello from test" >> "$LOG"
  sleep 2; echo "STATUS=0" > "$FLAG"
"""

from __future__ import annotations

import os
import re
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

# Shared parsing (progress_filter, no GTK) and rendering (log_display)
# modules: installed to /usr/share/timeshift-on-demand/, or ../../src when
# run from a checkout. The installed copy wins, so test a checkout on a
# machine without the package, or test the .deb itself.
for _d in ("/usr/share/timeshift-on-demand",
           os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "src")):
    if os.path.isfile(os.path.join(_d, "progress_filter.py")):
        sys.path.insert(0, _d)
        break
from log_display import LogDisplay  # noqa: E402
from progress_filter import PROGRESS, ProgressFilter  # noqa: E402

POLL_INTERVAL_MS = 500
WARN_AT_S = 1200  # 20 minutes before the first "this may be stuck" notice
WARN_INTERVAL_S = 300  # repeat every 5 minutes after that


class MonitorWindow(Gtk.Window):
    def __init__(self, logfile: str, doneflag: str, close_delay: int):
        super().__init__(title="Timeshift On Demand — Backup Monitor")
        self.set_default_size(600, 400)
        self.logfile = logfile
        self.doneflag = doneflag
        self.close_delay = close_delay

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(12)
        self.add(box)

        self.status_label = Gtk.Label(label="Backup running...", xalign=0)
        box.pack_start(self.status_label, False, False, 0)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.text_view = Gtk.TextView()
        self.text_view.set_editable(False)
        self.text_view.set_monospace(True)
        self.buffer = self.text_view.get_buffer()
        scroller.add(self.text_view)
        self.display = LogDisplay(self.buffer, scroller)
        self.filter = ProgressFilter()
        box.pack_start(scroller, True, True, 0)

        self.close_btn = Gtk.Button(label="Close")
        self.close_btn.set_sensitive(False)
        self.close_btn.connect("clicked", lambda *_: self._finish_and_quit())
        box.pack_start(self.close_btn, False, False, 0)

        self.connect("delete-event", self._on_delete)

        # Only stream NEW lines from this point onward, matching the old
        # `tail -f -n 0` behavior — seek to end of file first.
        self._log_pos = 0
        self._log_ino = None
        try:
            st = os.stat(logfile)
            self._log_pos, self._log_ino = st.st_size, st.st_ino
        except OSError:
            pass

        self._elapsed_s = 0.0
        self._next_warn_s = WARN_AT_S
        self._done = False

        GLib.timeout_add(POLL_INTERVAL_MS, self._tick)

    def _append(self, text: str) -> None:
        """Add a notice as normal lines (ends any live progress line)."""
        for line in text.strip("\n").split("\n"):
            self.display.add_line(line)

    def _poll_new_log_lines(self) -> None:
        # Binary read: text mode would turn Timeshift's \r progress
        # updates into \n before the display code could see them.
        try:
            st = os.stat(self.logfile)
            if st.st_size < self._log_pos or (
                self._log_ino is not None and st.st_ino != self._log_ino
            ):
                # The log was trimmed/replaced (it is cut to its last 5 MiB
                # once past 10 MiB). Old offsets mean nothing now; continue
                # from the end rather than replaying old history.
                self._log_pos = st.st_size
                self.filter.reset()
                self._log_ino = st.st_ino
                self._append(
                    "[log file was replaced; some output from this run may be "
                    f"missing - the result below is still accurate. Full log: {self.logfile}]"
                )
                return
            self._log_ino = st.st_ino
            with open(self.logfile, "rb") as f:
                f.seek(self._log_pos)
                data = f.read()
                self._log_pos += len(data)
        except OSError:
            return
        if data:
            self._show(self.filter.feed(data))

    def _show(self, events) -> None:
        self.display.apply(events)
        if not self._done:
            for ev in reversed(events):
                if ev.kind == PROGRESS:
                    rem = f" ({ev.remaining} remaining)" if ev.remaining else ""
                    self.status_label.set_text(f"Backup running... {min(ev.percent, 100):g}%{rem}")
                    break

    def _tick(self) -> bool:
        if self._done:
            return False

        self._poll_new_log_lines()

        if os.path.exists(self.doneflag):
            self._on_finished()
            return False

        self._elapsed_s += POLL_INTERVAL_MS / 1000
        if self._elapsed_s >= self._next_warn_s:
            mins = int(self._elapsed_s // 60)
            self._append(
                f"\n[still waiting after {mins}m — this may be stuck; "
                f"check 'ps aux | grep timeshift' if concerned]\n"
            )
            self._next_warn_s += WARN_INTERVAL_S

        return True

    def _on_finished(self) -> None:
        self._done = True
        status_code = None
        try:
            content = open(self.doneflag, encoding="utf-8").read()
            m = re.search(r"STATUS=(-?\d+)", content)
            if m:
                status_code = m.group(1)
        except OSError:
            pass

        self._poll_new_log_lines()  # catch any final lines written just before doneflag appeared
        self._show(self.filter.finish())  # flush any held-back fragment

        if status_code == "0":
            self.status_label.set_text("RESULT: SUCCESS")
            self._append(f"\n=== SUCCESS ===\nClosing in {self.close_delay}s...\n")
            GLib.timeout_add_seconds(self.close_delay, self._finish_and_quit)
        else:
            self.status_label.set_text(f"RESULT: FAILED (exit code: {status_code or 'unknown'})")
            self._append(
                f"\n=== FAILED (exit code: {status_code or 'unknown'}) ===\n"
                f"This window will stay open until you close it.\n"
            )
        self.close_btn.set_sensitive(True)

    def _finish_and_quit(self) -> bool:
        try:
            os.remove(self.doneflag)
        except OSError:
            pass
        Gtk.main_quit()
        return False

    def _on_delete(self, *_args) -> bool:
        self._finish_and_quit()
        return False  # allow the window to actually close


def main() -> int:
    if len(sys.argv) < 3:
        print(
            "Usage: timeshift-on-demand-gui-monitor <logfile> <doneflag> [close_delay_seconds]",
            file=sys.stderr,
        )
        return 1

    logfile = sys.argv[1]
    doneflag = sys.argv[2]
    close_delay = int(sys.argv[3]) if len(sys.argv) > 3 else 10

    if not os.path.exists(logfile):
        open(logfile, "a", encoding="utf-8").close()

    win = MonitorWindow(logfile, doneflag, close_delay)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
