#!/bin/sh
#
# Thin launcher installed to /usr/bin/timeshift-on-demand by the .deb.
# The app itself is plain Python/GTK3, launched unprivileged — no pkexec
# here. The one privileged action, the backup, is pkexec'd from within the
# running app itself, against the helper in /usr/lib/timeshift-on-demand/
# — never the whole process.
#
exec python3 /usr/share/timeshift-on-demand/main.py "$@"
