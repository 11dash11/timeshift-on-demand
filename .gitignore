# Python bytecode
__pycache__/
*.pyc

# Debian build artifacts (regenerated by dpkg-buildpackage)
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/timeshift-on-demand/
debian/timeshift-on-demand.debhelper.log
debian/timeshift-on-demand.substvars
debian/timeshift-on-demand.postrm.debhelper
debian/timeshift-on-demand.postinst.debhelper

# Built package output (also lands one directory above the repo root
# from a normal dpkg-buildpackage run, outside this tree entirely)
output/
*.deb
*.buildinfo
*.changes

# Raw, uncropped desktop screenshots used as sources for docs/images/*.png
# — these show full-desktop content (other windows, notifications,
# terminal output) and were never meant to be published as-is.
docs/Screenshot from *.png

# Internal build/decision log — not part of the public-facing docs set
PROJECT.md
